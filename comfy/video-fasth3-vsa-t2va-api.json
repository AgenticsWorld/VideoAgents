{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "{{H3_UNET}}", "weight_dtype": "default"}},
  "2": {"class_type": "FastH3VSAPatch", "inputs": {"model": ["1", 0], "keep_percent": 10.0, "min_tokens": 0, "failure_mode": "error", "allow_unsupported_conditioning": false, "verbose": true}},
  "3": {"class_type": "MiniMaxH3SigmaShift", "inputs": {"model": ["2", 0], "shift_video": 12.0, "shift_audio": 3.0}},
  "4": {"class_type": "CLIPLoader", "inputs": {"clip_name": "{{H3_TEXT_ENCODER}}", "type": "minimax", "device": "default"}},
  "5": {"class_type": "VAELoader", "inputs": {"vae_name": "{{H3_VIDEO_VAE}}"}},
  "6": {"class_type": "MiniMaxH3ImageToVideo", "inputs": {"clip": ["4", 0], "vae": ["5", 0], "prompt": "{{PROMPT}}", "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "length": "{{H3_FRAMES}}"}},
  "7": {"class_type": "RandomNoise", "inputs": {"noise_seed": "{{SEED}}"}},
  "8": {"class_type": "BasicGuider", "inputs": {"model": ["3", 0], "conditioning": ["6", 0]}},
  "9": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
  "10": {"class_type": "BasicScheduler", "inputs": {"model": ["3", 0], "scheduler": "simple", "steps": 4, "denoise": 1.0}},
  "11": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["7", 0], "guider": ["8", 0], "sampler": ["9", 0], "sigmas": ["10", 0], "latent_image": ["6", 1]}},
  "12": {"class_type": "VAEDecode", "inputs": {"samples": ["11", 0], "vae": ["5", 0]}},
  "13": {"class_type": "CreateVideo", "inputs": {"images": ["12", 0], "fps": "{{FPS}}", "audio": ["17", 0], "bit_depth": 8}},
  "14": {"class_type": "SaveVideo", "inputs": {"video": ["13", 0], "filename_prefix": "videoagents/fasth3", "format": "mp4", "codec": "h264", "codec.encoding": "auto"}},
  "16": {"class_type": "VAELoader", "inputs": {"vae_name": "{{H3_AUDIO_VAE}}"}},
  "17": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["11", 0], "vae": ["16", 0]}}
}
