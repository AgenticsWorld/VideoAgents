{
  "1": {
    "inputs": {
      "model_name": "wanvideo/Wan2_1_VAE_bf16.safetensors",
      "precision": "bf16"
    },
    "class_type": "WanVideoVAELoader",
    "_meta": {"title": "Wan Video VAE"}
  },
  "2": {
    "inputs": {"clip_name": "clip_vision_h.safetensors"},
    "class_type": "CLIPVisionLoader",
    "_meta": {"title": "CLIP Vision"}
  },
  "3": {
    "inputs": {"image": "{{IMAGE}}"},
    "class_type": "LoadImage",
    "_meta": {"title": "Digital Human Image"}
  },
  "4": {
    "inputs": {
      "clip_vision": ["2", 0],
      "image_1": ["3", 0],
      "strength_1": 1.0,
      "strength_2": 1.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true,
      "tiles": 0,
      "ratio": 0.5
    },
    "class_type": "WanVideoClipVisionEncode",
    "_meta": {"title": "Encode Portrait"}
  },
  "5": {
    "inputs": {"model": "WanVideo/InfiniteTalk/Wan2_1-InfiniteTalk_Single_Q8.gguf"},
    "class_type": "MultiTalkModelLoader",
    "_meta": {"title": "InfiniteTalk Model"}
  },
  "6": {
    "inputs": {
      "model": "WanVideo/wan2.1-i2v-14b-480p-Q8_0.gguf",
      "base_precision": "fp16_fast",
      "quantization": "disabled",
      "load_device": "offload_device",
      "attention_mode": "sdpa",
      "multitalk_model": ["5", 0]
    },
    "class_type": "WanVideoModelLoader",
    "_meta": {"title": "Wan I2V Model"}
  },
  "7": {
    "inputs": {
      "model": "wav2vec2-chinese-base_fp16.safetensors",
      "base_precision": "fp16",
      "load_device": "main_device"
    },
    "class_type": "Wav2VecModelLoader",
    "_meta": {"title": "Wav2Vec"}
  },
  "8": {
    "inputs": {"audio": "{{AUDIO}}"},
    "class_type": "LoadAudio",
    "_meta": {"title": "Dialogue Audio"}
  },
  "9": {
    "inputs": {
      "wav2vec_model": ["7", 0],
      "audio_1": ["8", 0],
      "normalize_loudness": true,
      "num_frames": "{{FRAMES}}",
      "fps": 25.0,
      "audio_scale": 1.0,
      "audio_cfg_scale": 1.0,
      "multi_audio_type": "para"
    },
    "class_type": "MultiTalkWav2VecEmbeds",
    "_meta": {"title": "InfiniteTalk Audio Embeds"}
  },
  "10": {
    "inputs": {
      "model_name": "umt5-xxl-enc-bf16.safetensors",
      "precision": "bf16",
      "positive_prompt": "{{PROMPT}}",
      "negative_prompt": "bright tones, overexposed, static, blurred details, subtitles, paintings, low quality, jpeg artifacts, deformed face, extra limbs, camera movement",
      "quantization": "disabled",
      "use_disk_cache": true,
      "device": "gpu"
    },
    "class_type": "WanVideoTextEncodeCached",
    "_meta": {"title": "Motion Prompt"}
  },
  "11": {
    "inputs": {
      "vae": ["1", 0],
      "width": 832,
      "height": 480,
      "frame_window_size": 81,
      "motion_frame": 9,
      "force_offload": false,
      "colormatch": "disabled",
      "start_image": ["3", 0],
      "tiled_vae": false,
      "clip_embeds": ["4", 0],
      "mode": "infinitetalk",
      "output_path": ""
    },
    "class_type": "WanVideoImageToVideoMultiTalk",
    "_meta": {"title": "InfiniteTalk Image To Video"}
  },
  "12": {
    "inputs": {
      "model": ["6", 0],
      "image_embeds": ["11", 0],
      "text_embeds": ["10", 0],
      "steps": 6,
      "cfg": 1.0,
      "shift": 11.0,
      "seed": "{{SEED}}",
      "force_offload": true,
      "scheduler": "dpm++_sde",
      "riflex_freq_index": 0,
      "denoise_strength": 1.0,
      "batched_cfg": false,
      "rope_function": "comfy",
      "start_step": 0,
      "end_step": -1,
      "add_noise_to_samples": true,
      "multitalk_embeds": ["9", 0]
    },
    "class_type": "WanVideoSampler",
    "_meta": {"title": "Sample InfiniteTalk"}
  },
  "13": {
    "inputs": {"samples": ["12", 0]},
    "class_type": "WanVideoPassImagesFromSamples",
    "_meta": {"title": "Frames"}
  },
  "14": {
    "inputs": {
      "images": ["13", 0],
      "audio": ["9", 1],
      "frame_rate": 25,
      "loop_count": 0,
      "filename_prefix": "digitalhuman/infinitetalk",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true
    },
    "class_type": "VHS_VideoCombine",
    "_meta": {"title": "Save Digital Human Clip"}
  }
}
