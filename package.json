{
  "name": "videoagents-product",
  "private": true,
  "version": "1.0.39",
  "workspaces": ["apps/desktop"],
  "dependencies": {
    "baileys": "^6.7.18"
  },
  "scripts": {
    "dev:web": "node apps/web/run-server.mjs",
    "build:web": "node apps/web/run-check.mjs",
    "dev:desktop": "npm run dev --workspace @videoagents/desktop",
    "build:desktop": "npm run build:web && npm run build --workspace @videoagents/desktop",
    "typecheck": "npm run typecheck --workspace @videoagents/desktop",
    "test:web": "node --test \"tests/*.mjs\""
  },
  "engines": {"node": ">=22.12"}
}
