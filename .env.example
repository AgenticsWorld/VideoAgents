# The public release listens on localhost by default.
VIDEOAGENTS_HOST=127.0.0.1
VIDEOAGENTS_PORT=8630

# acceptEdits is the recommended default. bypassPermissions allows agents to
# execute commands and modify files without confirmation and should only be
# used in a trusted, isolated workspace.
VIDEOAGENTS_PERMISSION_MODE=acceptEdits

# Disabled by default because the probe reads the local Claude OAuth credential.
VIDEOAGENTS_ENABLE_CLAUDE_USAGE_PROBE=false

# Optional CLI and DeepAgents executable overrides.
CLAUDE_BIN=claude
CODEX_BIN=codex
PI_BIN=pi
# DEEPAGENTS_PY=/absolute/path/to/python
