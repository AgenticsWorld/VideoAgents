# The public release listens on localhost by default.
VIDEOAGENTS_HOST=127.0.0.1
VIDEOAGENTS_PORT=8630

# acceptEdits is the recommended default. bypassPermissions allows agents to
# execute commands and modify files without confirmation and should only be
# used in a trusted, isolated workspace.
VIDEOAGENTS_PERMISSION_MODE=acceptEdits

# Disabled by default because the probe reads the local Claude OAuth credential.
VIDEOAGENTS_ENABLE_CLAUDE_USAGE_PROBE=false

# Optional CLI executable overrides.
CLAUDE_BIN=claude
CODEX_BIN=codex
PI_BIN=pi
OPENCODE_BIN=opencode
# Agentics engine (bundled pi in vendor/pi, installed with `make install-pi`).
# Node used to run it from source (the desktop app passes its own Electron binary).
# VIDEOAGENTS_NODE=/absolute/path/to/node
# Model limits written into pi's models.json (pi compacts the session before the window fills).
# AGENTICS_CONTEXT_WINDOW=128000
# AGENTICS_MAX_OUTPUT_TOKENS=16384   # local-model channel defaults to 8192
